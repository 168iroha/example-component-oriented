{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"checkJs": true,
		"allowJs": true,
		"noEmit": true,
		"strict": false,
		"strictNullChecks": false,
		"skipLibCheck": true,
		"lib": [
			"ES2022",
			"DOM"
		]
	},
	"include": [
		"src/**/*.js",
		"sample/lib/**/*.js"
	]
}
